# Non-target territory activity can be computed for everyone because it is
# based on predictors. Territory adoption rate is target-derived and MUST
# be fit from TRAIN ONLY.
def add_territory_features(feature_df, behavior_df, profile_df, fit_ids):
    out = feature_df.copy()

    # Activity by territory based on all rows belonging to fit_ids.
    fit_beh = behavior_df[
        behavior_df["physician_id"].isin(fit_ids)
    ].copy()

    territory_map = profile_df[
        profile_df["physician_id"].isin(fit_ids)
    ][["physician_id", "territory_code"]].drop_duplicates("physician_id")

    fit_beh = fit_beh.merge(territory_map, on="physician_id", how="left")

    if "territory_code" in fit_beh.columns:
        terr_activity = (
            fit_beh.groupby("territory_code")
            .agg(
                territory_avg_rep_calls=("rep_calls", "mean"),
                territory_avg_samples=("samples_provided", "mean"),
                territory_avg_digital=("digital_engagements", "mean"),
                territory_avg_competitor_rx=("competitive_rx_count", "mean")
            )
            .reset_index()
        )

        out = out.merge(terr_activity, on="territory_code", how="left")

    # Target-derived adoption rate: TRAIN ONLY.
    fit_label = adoption_label.reindex(list(fit_ids)).dropna().astype(int)
    fit_prof = profile_df[
        profile_df["physician_id"].isin(fit_ids)
    ][["physician_id", "territory_code"]].drop_duplicates("physician_id")

    terr_y = fit_prof.merge(
        fit_label.rename("adopted"),
        left_on="physician_id", right_index=True, how="inner"
    )

    if not terr_y.empty:
        global_rate = float(terr_y["adopted"].mean())
        terr_rate = (
            terr_y.groupby("territory_code")["adopted"]
            .agg(["mean", "count"])
            .reset_index()
        )
        terr_rate["smoothed_territory_adoption_rate"] = (
            terr_rate["mean"] * terr_rate["count"] +
            global_rate * 10
        ) / (terr_rate["count"] + 10)

        terr_rate = terr_rate[
