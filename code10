def make_model(model_name, params=None):
    params = params or {}

    if model_name == "Logistic Regression":
        return LogisticRegression(
            C=params.get("C", 1.0),
            max_iter=3000,
            class_weight=params.get("class_weight", "balanced"),
            random_state=SEED
        )

    if model_name == "Random Forest":
        return RandomForestClassifier(
            n_estimators=params.get("n_estimators", 500),
            max_depth=params.get("max_depth", None),
            min_samples_leaf=params.get("min_samples_leaf", 2),
            max_features=params.get("max_features", "sqrt"),
            class_weight=params.get("class_weight", "balanced_subsample"),
            oob_score=True,
            bootstrap=True,
            n_jobs=-1,
            random_state=SEED
        )

    if model_name == "XGBoost":
        if not XGB_AVAILABLE:
            raise ImportError(
                "xgboost is not installed. Install it with: pip install xgboost"
            )
        # scale_pos_weight is calculated from TRAIN only when params do not
        # explicitly supply it.
        neg = max(int((y_train == 0).sum()), 1)
        pos = max(int((y_train == 1).sum()), 1)
        spw = neg / pos

        return XGBClassifier(
            n_estimators=params.get("n_estimators", 400),
            max_depth=params.get("max_depth", 5),
            learning_rate=params.get("learning_rate", 0.05),
            subsample=params.get("subsample", 0.85),
            colsample_bytree=params.get("colsample_bytree", 0.85),
            min_child_weight=params.get("min_child_weight", 2),
            gamma=params.get("gamma", 0.0),
            reg_alpha=params.get("reg_alpha", 0.0),
            reg_lambda=params.get("reg_lambda", 1.0),
            objective="binary:logistic",
            eval_metric="logloss",
            scale_pos_weight=params.get("scale_pos_weight", spw),
            random_state=SEED,
            n_jobs=-1
        )

    if model_name == "Gradient Boosting":
        return GradientBoostingClassifier(
            n_estimators=params.get("n_estimators", 250),
            max_depth=params.get("max_depth", 3),
            learning_rate=params.get("learning_rate", 0.05),
            random_state=SEED
        )

    raise ValueError(f"Unknown model: {model_name}")

def build_pipeline(model_name, params=None):
    model = make_model(model_name, params)

    steps = [("preprocessor", preprocessor)]

    # SMOTETomek must be applied only to the training fold. ImbPipeline
    # guarantees this during CV.
    if IMBLEARN_AVAILABLE and model_name in {
        "Logistic Regression", "Random Forest", "XGBoost"
    }:
        steps.append((
            "smotetomek",
            SMOTETomek(random_state=SEED)
        ))

    steps.append(("model", model))

    if IMBLEARN_AVAILABLE and model_name in {
        "Logistic Regression", "Random Forest", "XGBoost"
    }:
        return ImbPipeline(steps)
    return Pipeline(steps)

