def add_clusters(train_feature_df, all_feature_df, n_clusters=5):
    tr = train_feature_df[cluster_numeric].copy()
    allx = all_feature_df[cluster_numeric].copy()

    tr = tr.replace([np.inf, -np.inf], np.nan)
    allx = allx.replace([np.inf, -np.inf], np.nan)

    med = tr.median(numeric_only=True)
    tr = tr.fillna(med).fillna(0)
    allx = allx.fillna(med).fillna(0)

    scaler = StandardScaler()
    tr_scaled = scaler.fit_transform(tr)
    all_scaled = scaler.transform(allx)

    km = KMeans(
        n_clusters=n_clusters,
        random_state=SEED,
        n_init=20
    )
    km.fit(tr_scaled)

    result = all_feature_df.copy()
    result["behavior_cluster"] = km.predict(all_scaled)
    return result, km, scaler

