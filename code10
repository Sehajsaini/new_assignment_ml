# -----------------------------
# 9. Remove obvious redundant features
# -----------------------------
# We do NOT blindly remove every VIF > 10 because engineered time-series
# variables are naturally correlated. Instead, we use a correlation-based
# reduction for extremely redundant pairs, while keeping meaningful
# momentum/trend variables.
#
# This avoids unstable logistic coefficients while preserving the requested
# feature-engineering logic.
def correlation_reduction(df, numeric_cols, threshold=0.97):
    cols = [c for c in numeric_cols if c in df.columns]
    if len(cols) < 2:
        return []

    tmp = df[cols].copy()
    tmp = tmp.replace([np.inf, -np.inf], np.nan)
    tmp = tmp.fillna(tmp.median(numeric_only=True)).fillna(0)

    corr = tmp.corr().abs()
    upper = corr.where(np.triu(np.ones(corr.shape), k=1).astype(bool))

    drop = []
    for col in upper.columns:
        if (upper[col] > threshold).any():
            # Prefer retaining explicitly engineered trend/momentum features.
            if "momentum" in col or "trend" in col or "slope" in col:
                continue
            drop.append(col)
    return sorted(set(drop))

corr_drop = correlation_reduction(train_base, numeric_for_corr, 0.97)

