def find_csv_by_columns(required_columns, preferred_names=None):
    """Find a CSV by required column names, without hard-coding the folder."""
    preferred_names = preferred_names or []
    candidates = []

    for name in preferred_names:
        p = BASE_DIR / name
        if p.exists():
            candidates.append(p)

    candidates.extend([Path(x) for x in glob.glob(str(BASE_DIR / "*.csv"))])

    seen = set()
    for p in candidates:
        if p in seen:
            continue
        seen.add(p)
        try:
            cols = set(pd.read_csv(p, nrows=5).columns.astype(str))
            if set(required_columns).issubset(cols):
                return p
        except Exception:
            pass

    return None

