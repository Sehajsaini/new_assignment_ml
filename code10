    ("imputer", SimpleImputer(strategy="most_frequent")),
    ("onehot", OneHotEncoder(handle_unknown="ignore"))
])

final_preprocessor = ColumnTransformer([
    ("num", final_numeric_pipe, final_num_features),
    ("cat", final_categorical_pipe, final_cat_features)
])

def build_final_pipeline(model_name):
    model = make_model(model_name, {})

    steps = [("preprocessor", final_preprocessor)]

    if IMBLEARN_AVAILABLE and model_name in {
        "Logistic Regression", "Random Forest", "XGBoost"
    }:
        steps.append(("smotetomek", SMOTETomek(random_state=SEED)))

    steps.append(("model", model))

    if IMBLEARN_AVAILABLE and model_name in {
        "Logistic Regression", "Random Forest", "XGBoost"
    }:
        return ImbPipeline(steps)
    return Pipeline(steps)

final_model = build_final_pipeline(best_model_name)
final_model.fit(X_all_train, y_all_train)

