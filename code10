def safe_numeric_series(df, col):
    if col not in df.columns:
        return pd.Series(np.nan, index=df.index, dtype=float)
    return pd.to_numeric(df[col], errors="coerce")

def engineer_base_features(behavior_df, profile_df):
    """
    Creates physician-level features using only raw predictor variables.
    rx_count is deliberately excluded from all model features.
    """
    b = behavior_df.copy()
    b["quarter_num"] = pd.to_numeric(b["quarter_num"], errors="coerce")
    b = b.sort_values(["physician_id", "quarter_num"])

    rows = []

    for pid, g in b.groupby("physician_id", sort=False):
        g = g.sort_values("quarter_num").copy()
        row = {"physician_id": pid}

        qnums = g["quarter_num"].values

        # Aggregate totals / mean / max / std
        for c in ACTIVITY_FEATURES:
            s = safe_numeric_series(g, c)
            row[f"{c}_total"] = s.sum(min_count=1)
            row[f"{c}_mean"] = s.mean()
            row[f"{c}_std"] = s.std()
            row[f"{c}_max"] = s.max()

            recent = s[g["quarter_num"].isin([8, 9, 10])]
            early = s[g["quarter_num"].isin([1, 2, 3])]
            row[f"{c}_recent3_mean"] = recent.mean()
            row[f"{c}_early3_mean"] = early.mean()
            row[f"{c}_trend_recent_vs_early"] = (
                recent.mean() - early.mean()
            )

        # Recency: Q8-Q10
        recent_g = g[g["quarter_num"].isin([8, 9, 10])]
        row["speaker_recency_q8_q10"] = safe_numeric_series(
            recent_g, "speaker_program_attendance"
        ).sum(min_count=1)

        # Last-quarter levels
        q10 = g[g["quarter_num"] == 10]
        for c in ACTIVITY_FEATURES:
            row[f"{c}_q10"] = safe_numeric_series(q10, c).mean()

        # Q9 -> Q10 changes
        q9 = g[g["quarter_num"] == 9]
        for c in ACTIVITY_FEATURES:
            v9 = safe_numeric_series(q9, c).mean()
            v10 = safe_numeric_series(q10, c).mean()
            row[f"{c}_q10_minus_q9"] = v10 - v9

        # -------------------------
        # Momentum features
        # -------------------------
        # "Momentum" = monotonic increase over the last four quarters.
        # Also add a slope and a simple positive-change flag.
        last4 = g[g["quarter_num"].isin([7, 8, 9, 10])].sort_values("quarter_num")

        for c in [
            "rep_calls", "samples_provided", "digital_engagements",
            "competitive_rx_count", "peer_network_score",
            "medical_education_events"
        ]:
            vals = safe_numeric_series(last4, c).dropna().values

            if len(vals) >= 4:
                diffs = np.diff(vals)
                monotonic = int(np.all(diffs >= 0) and np.any(diffs > 0))
                positive_steps = int(np.sum(diffs > 0))
                # polyfit slope
                x = np.arange(len(vals), dtype=float)
                slope = float(np.polyfit(x, vals, 1)[0])
            else:
                monotonic = 0
                positive_steps = np.nan
                slope = np.nan

            row[f"{c}_momentum"] = monotonic
            row[f"{c}_positive_steps_last4"] = positive_steps
            row[f"{c}_slope_last4"] = slope

        # Overall engagement intensity
        row["total_engagement_intensity"] = (
            row.get("rep_calls_total", 0)
            + row.get("samples_provided_total", 0)
            + row.get("digital_engagements_total", 0)
        )

        # Rep-call / digital engagement ratio
        row["rep_to_digital_ratio"] = (
            row["rep_calls_total"] /
            (row["digital_engagements_total"] + 1.0)
        )

        # Sample intensity per rep call
        row["samples_per_rep_call"] = (
            row["samples_provided_total"] /
            (row["rep_calls_total"] + 1.0)
        )

        rows.append(row)

    feat = pd.DataFrame(rows)

    # Merge static profile variables
    prof_cols = [
        "physician_id", "specialty", "years_in_practice", "practice_type",
        "geographic_region", "state", "territory_code", "hcp_decile",
        "payer_access_score", "kol_flag", "hospital_affiliation",
        "board_certified", "practice_size"
    ]
    prof_cols = [c for c in prof_cols if c in profile_df.columns]
    feat = feat.merge(
        profile_df[prof_cols].drop_duplicates("physician_id"),
        on="physician_id", how="left"
    )

    return feat

