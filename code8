# 25. FIND BEST CLASSIFICATION THRESHOLD
# =============================================================================
#
# AUC is threshold-independent and used for model selection.
# F1 threshold is optimized separately on validation data.
# =============================================================================

threshold_results = []

for threshold in np.arange(
    0.10,
    0.91,
    0.01
):

    predictions = (
        best_validation_probabilities >= threshold
    ).astype(int)

    threshold_results.append(
        {
            "threshold": threshold,
            "f1_score": f1_score(
                y_valid,
                predictions,
                zero_division=0
            ),
            "precision": precision_score(
                y_valid,
                predictions,
                zero_division=0
            ),
            "recall": recall_score(
                y_valid,
                predictions,
                zero_division=0
            )
        }
    )

threshold_table = pd.DataFrame(
    threshold_results
)

best_threshold = threshold_table.loc[
    threshold_table["f1_score"].idxmax(),
    "threshold"
]

print(
    "\nBest Validation Threshold:",
    round(best_threshold, 2)
)

print("\nThreshold Results:")
display(
    threshold_table
    .sort_values(
