# =============================================================================
# 9. HELPER FUNCTION - SAFE DIVISION
# =============================================================================

def safe_divide(numerator, denominator):
    """
    Prevents division by zero and infinity.
    """

    denominator = denominator.replace(0, np.nan)

    result = numerator / denominator

    return result.replace(
        [np.inf, -np.inf],
        np.nan
    )


# =============================================================================
# 10. CREATE TEMPORAL FEATURES
# =============================================================================
#
# For every physician at prediction quarter t:
#
# Features = information available from Q1 through Qt
# Target   = adoption in Q(t+1)
#
# No future information is used in the features.
# =============================================================================

def create_temporal_features(
    longitudinal_data,
    static_data,
    prediction_quarter,
    numeric_columns
):

    history = longitudinal_data[
        longitudinal_data["quarter_num"] <= prediction_quarter
    ].copy()

    history = history.sort_values(
        ["physician_id", "quarter_num"]
    )

    physician_ids = history[
        ["physician_id"]
    ].drop_duplicates()

    feature_data = physician_ids.copy()

    # -------------------------------------------------------------------------
    # A. HISTORICAL AVERAGES
    # -------------------------------------------------------------------------

    historical_means = (
        history.groupby("physician_id")[
            numeric_columns
        ]
        .mean()
        .add_prefix("mean_")
        .reset_index()
    )

    feature_data = feature_data.merge(
        historical_means,
        on="physician_id",
        how="left"
    )

    # -------------------------------------------------------------------------
    # B. HISTORICAL TOTALS
    # -------------------------------------------------------------------------

    historical_totals = (
        history.groupby("physician_id")[
            numeric_columns
        ]
        .sum()
        .add_prefix("total_")
        .reset_index()
    )

    feature_data = feature_data.merge(
        historical_totals,
        on="physician_id",
        how="left"
    )

    # -------------------------------------------------------------------------
    # C. RECENT 3-QUARTER AVERAGES
    # -------------------------------------------------------------------------

    recent_start = max(1, prediction_quarter - 2)

    recent_history = history[
        history["quarter_num"].between(
            recent_start,
            prediction_quarter
        )
    ]

    recent_means = (
        recent_history.groupby("physician_id")[
            numeric_columns
        ]
        .mean()
        .add_prefix("recent_mean_")
        .reset_index()
    )

    feature_data = feature_data.merge(
        recent_means,
        on="physician_id",
        how="left"
    )

    # -------------------------------------------------------------------------
    # D. EARLIER VS RECENT CHANGE
    # -------------------------------------------------------------------------

    early_history = history[
        history["quarter_num"] < recent_start
    ]

    if len(early_history) > 0:

        early_means = (
            early_history.groupby("physician_id")[
                numeric_columns
            ]
            .mean()
            .add_prefix("early_mean_")
            .reset_index()
        )

        feature_data = feature_data.merge(
            early_means,
            on="physician_id",
            how="left"
        )

        for column in numeric_columns:

            recent_column = f"recent_mean_{column}"
            early_column = f"early_mean_{column}"

            if (
                recent_column in feature_data.columns
                and early_column in feature_data.columns
            ):
                feature_data[
                    f"trend_{column}"
                ] = (
                    feature_data[recent_column]
                    - feature_data[early_column]
                )

    # -------------------------------------------------------------------------
    # E. MOST RECENT QUARTER VALUES
    # -------------------------------------------------------------------------

    latest_data = history[
        history["quarter_num"] == prediction_quarter
    ]

    latest_columns = [
        "physician_id"
    ] + numeric_columns

    latest_features = (
        latest_data[latest_columns]
        .copy()
        .rename(
            columns={
                column: f"latest_{column}"
                for column in numeric_columns
            }
        )
    )

    feature_data = feature_data.merge(
        latest_features,
        on="physician_id",
        how="left"
    )

    # -------------------------------------------------------------------------
    # F. RECENCY RATIOS
    # -------------------------------------------------------------------------

    for column in numeric_columns:

        recent_column = f"recent_mean_{column}"
        mean_column = f"mean_{column}"

        if (
            recent_column in feature_data.columns
            and mean_column in feature_data.columns
        ):
            feature_data[
                f"recent_ratio_{column}"
            ] = safe_divide(
                feature_data[recent_column],
                feature_data[mean_column]
            )

    # -------------------------------------------------------------------------
    # G. SLOPE / MOMENTUM FEATURES
    # -------------------------------------------------------------------------

    slope_records = []

    for physician_id, group in history.groupby(
        "physician_id"
    ):

        group = group.sort_values("quarter_num")

        record = {
            "physician_id": physician_id
        }

        for column in numeric_columns:

            values = group[column].dropna().values

            if len(values) >= 2:

                x = np.arange(len(values))

                record[f"slope_{column}"] = np.polyfit(
                    x,
                    values,
                    1
                )[0]

            else:

                record[f"slope_{column}"] = 0

        slope_records.append(record)

    slope_data = pd.DataFrame(slope_records)

    feature_data = feature_data.merge(
        slope_data,
        on="physician_id",
        how="left"
    )

    # -------------------------------------------------------------------------
    # H. MERGE STATIC PHYSICIAN INFORMATION
    # -------------------------------------------------------------------------

    feature_data = feature_data.merge(
        static_data,
        on="physician_id",
        how="left"
    )

    # -------------------------------------------------------------------------
    # I. ADD PREDICTION QUARTER
    # -------------------------------------------------------------------------

    feature_data["prediction_quarter"] = prediction_quarter

    return feature_data


# =============================================================================
# 11. CREATE ROLLING TRAINING DATASET
# =============================================================================
#
# Example:
# Features through Q3 -> target from Q4
# Features through Q4 -> target from Q5
# ...
# Features through Q9 -> target from Q10
#
# This gives us a genuine historical simulation of future prediction.
# =============================================================================

max_quarter = file1["quarter_num"].max()

training_records = []

for prediction_quarter in range(3, max_quarter):

    print(
        f"Creating features through Q{prediction_quarter} "
        f"for target Q{prediction_quarter + 1}"
    )

    features = create_temporal_features(
        longitudinal_data=file1,
        static_data=file2,
        prediction_quarter=prediction_quarter,
        numeric_columns=numeric_behavior_columns
    )

    next_quarter_target = file1[
        file1["quarter_num"] == prediction_quarter + 1
    ][
        ["physician_id", "rx_count"]
    ].copy()

    next_quarter_target["target"] = (
        next_quarter_target["rx_count"] > 0
    ).astype(int)

    next_quarter_target = next_quarter_target[
        ["physician_id", "target"]
    ]

    period_data = features.merge(
        next_quarter_target,
        on="physician_id",
        how="inner"
    )

    training_records.append(period_data)


model_data = pd.concat(
    training_records,
    ignore_index=True
)

