        ascending=False
    )
    .head(10)
    .round(4)
)


# =============================================================================
# 26. FINAL VALIDATION RESULTS USING BEST THRESHOLD
# =============================================================================

final_valid_predictions = (
    best_validation_probabilities
    >= best_threshold
).astype(int)

print("\n" + "=" * 80)
print("FINAL VALIDATION CLASSIFICATION REPORT")
