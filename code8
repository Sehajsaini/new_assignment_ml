)


# =============================================================================
# 30. ALIGN FINAL Q11 FEATURES WITH TRAINING FEATURES
# =============================================================================

X_final = q11_features.drop(
    columns=["physician_id"]
)

# Add missing training columns if necessary
for column in X_train.columns:

    if column not in X_final.columns:
        X_final[column] = np.nan

# Remove additional columns and preserve exact order
X_final = X_final.reindex(
    columns=X_train.columns
)

print(
    "Final Q11 feature shape:",
    X_final.shape
)


# =============================================================================
# 31. RETRAIN THE SELECTED MODEL ON ALL HISTORICAL TRANSITIONS
# =============================================================================
#
# After model selection, retrain using all historical transition data.
# =============================================================================

X_all = model_data.drop(
    columns=[
        "physician_id",
        "target"
    ]
)

y_all = model_data["target"].copy()

# Align columns
X_all = X_all.reindex(
    columns=X_train.columns
)

print(
    "\nRetraining final model on all historical data..."
)


if best_model_name == "Logistic Regression":

    final_model = Pipeline(
        steps=[
            (
                "preprocessor",
                preprocessor
            ),
            (
                "model",
                LogisticRegression(
                    max_iter=3000,
                    class_weight="balanced",
                    C=1.0,
                    random_state=RANDOM_STATE
                )
            )
        ]
    )


elif best_model_name == "Random Forest":

    final_model = Pipeline(
        steps=[
            (
                "preprocessor",
                preprocessor
            ),
            (
                "model",
                RandomForestClassifier(
                    n_estimators=500,
                    max_depth=12,
                    min_samples_leaf=5,
                    max_features="sqrt",
                    class_weight="balanced",
                    n_jobs=-1,
                    random_state=RANDOM_STATE
                )
            )
        ]
    )


else:

    final_negative_class = (
        y_all == 0
    ).sum()

    final_positive_class = (
        y_all == 1
    ).sum()

    final_scale_pos_weight = (
        final_negative_class
        / final_positive_class
    )

    final_model = Pipeline(
        steps=[
            (
                "preprocessor",
                preprocessor
            ),
            (
                "model",
                XGBClassifier(
                    objective="binary:logistic",
                    eval_metric="logloss",
                    random_state=RANDOM_STATE,
                    n_jobs=-1,
                    tree_method="hist",
                    scale_pos_weight=final_scale_pos_weight,
                    n_estimators=xgb_grid.best_params_[
                        "model__n_estimators"
                    ],
                    max_depth=xgb_grid.best_params_[
                        "model__max_depth"
                    ],
                    learning_rate=xgb_grid.best_params_[
                        "model__learning_rate"
                    ],
                    subsample=xgb_grid.best_params_[
                        "model__subsample"
                    ],
                    colsample_bytree=xgb_grid.best_params_[
                        "model__colsample_bytree"
                    ],
                    min_child_weight=xgb_grid.best_params_[
                        "model__min_child_weight"
                    ]
                )
            )
        ]
    )


final_model.fit(
    X_all,
    y_all
)


