# 18. HELPER FUNCTION FOR MODEL EVALUATION
# =============================================================================

def evaluate_model(
    model_name,
    probabilities,
    actual_values,
    threshold=0.50
):

    predictions = (
        probabilities >= threshold
    ).astype(int)

    results = {
        "Model": model_name,
        "AUC-ROC": roc_auc_score(
            actual_values,
            probabilities
        ),
        "PR-AUC": average_precision_score(
            actual_values,
            probabilities
        ),
        "F1-Score": f1_score(
            actual_values,
            predictions,
            zero_division=0
        ),
        "Precision": precision_score(
            actual_values,
            predictions,
            zero_division=0
        ),
        "Recall": recall_score(
            actual_values,
            predictions,
            zero_division=0
        ),
        "Accuracy": accuracy_score(
            actual_values,
            predictions
        )
    }

    return results


