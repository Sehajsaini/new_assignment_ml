def encode_binary_target(y: pd.Series) -> Tuple[pd.Series, Dict]:
    """
    Convert common binary target representations to 0/1.
    Does not infer from feature columns.
    """
    y = y.copy()

    if y.isna().any():
        raise ValueError("Target contains missing values in labelled data.")

    vals = list(pd.unique(y))
    if len(vals) != 2:
        raise ValueError(
            f"Expected a binary target but found {len(vals)} unique values: {vals[:20]}"
        )

    # Already numeric 0/1.
    try:
        numeric = pd.to_numeric(y, errors="raise")
        u = sorted(pd.unique(numeric))
        if set(u) == {0, 1}:
            return numeric.astype(int), {"0": 0, "1": 1}
    except Exception:
        pass

    # Common string labels.
    normalized = y.astype(str).str.strip().str.lower()
    positive_words = {
        "1", "yes", "y", "true", "positive", "adopt", "adopted",
        "narcolepsy", "case", "success", "high"
    }
    negative_words = {
        "0", "no", "n", "false", "negative", "non-adopt", "not adopted",
        "healthy", "control", "failure", "low"
    }

    mapping = {}
    for original, norm in zip(vals, [str(v).strip().lower() for v in vals]):
        if norm in positive_words:
            mapping[original] = 1
        elif norm in negative_words:
            mapping[original] = 0

    if len(mapping) == 2 and set(mapping.values()) == {0, 1}:
        return y.map(mapping).astype(int), {str(k): int(v) for k, v in mapping.items()}

    # Deterministic fallback for exactly two labels: preserve sorted order.
    ordered = sorted(vals, key=lambda x: str(x))
    fallback = {ordered[0]: 0, ordered[1]: 1}
    return y.map(fallback).astype(int), {str(k): int(v) for k, v in fallback.items()}


