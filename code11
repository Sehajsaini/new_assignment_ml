    if target_col in numeric.columns:
        numeric = numeric.drop(columns=[target_col])

    if numeric.shape[1] == 0:
        print("No numeric features available.")
        return

    # Remove all-constant columns.
    numeric = numeric.loc[:, numeric.nunique(dropna=True) > 1]

    corr = numeric.corr(numeric_only=True)
    corr.to_csv(OUTPUT_DIR / "training_correlation_matrix.csv")

    try:
        plt.figure(figsize=(10, 8))
        plt.imshow(corr.fillna(0).to_numpy(), aspect="auto")
        plt.colorbar()
        plt.title("Training Numeric Feature Correlation")
        plt.tight_layout()
        plt.savefig(OUTPUT_DIR / "training_correlation_matrix.png", dpi=160)
        plt.close()
    except Exception as e:
        print("Correlation plot warning:", e)

    # VIF requires statsmodels. Use a bounded set to avoid enormous matrices.
    try:
        from statsmodels.stats.outliers_influence import variance_inflation_factor

        vif_df = numeric.copy()
        # Median imputation only for this descriptive diagnostic.
        vif_df = vif_df.replace([np.inf, -np.inf], np.nan)
        vif_df = vif_df.fillna(vif_df.median(numeric_only=True))
        vif_df = vif_df.loc[:, vif_df.nunique(dropna=True) > 1]

        # Avoid singular/huge matrices.
        if vif_df.shape[1] > 80:
            variances = vif_df.var().sort_values(ascending=False)
            vif_df = vif_df[variances.head(80).index]

        vals = vif_df.to_numpy(dtype=float)
        rows = []
        for i, c in enumerate(vif_df.columns):
            try:
                v = variance_inflation_factor(vals, i)
            except Exception:
                v = np.inf
            rows.append((c, v))

        out = pd.DataFrame(rows, columns=["feature", "VIF"])
        out.sort_values("VIF", ascending=False).to_csv(
            OUTPUT_DIR / "training_vif.csv", index=False
        )
        print("\nTop VIF values:")
        print(out.head(20))
    except Exception as e:
        print("VIF diagnostic skipped:", e)


# ------------------------------------------------------------
# K-MEANS TRANSFORMER — FITS ONLY INSIDE EACH TRAINING FOLD
# ------------------------------------------------------------

class SafeKMeansFeatures(BaseEstimator, TransformerMixin):
    """
    Adds KMeans cluster one-hot features from numeric inputs.

    It is a transformer so it is fitted only on each training fold when
    used inside the sklearn pipeline. Therefore KMeans does not leak
    validation/test information.
    """
    def __init__(self, n_clusters=4, random_state=42):
        self.n_clusters = n_clusters
        self.random_state = random_state

    def fit(self, X, y=None):
        X_arr = self._to_numeric_array(X)
        self.medians_ = np.nanmedian(X_arr, axis=0)
        self.medians_[~np.isfinite(self.medians_)] = 0.0
        X_imp = np.where(np.isfinite(X_arr), X_arr, self.medians_)

        # Standardize for distance.
        self.means_ = np.nanmean(X_imp, axis=0)
        self.stds_ = np.nanstd(X_imp, axis=0)
        self.stds_[self.stds_ == 0] = 1.0
        Z = (X_imp - self.means_) / self.stds_

        n_clusters = max(2, min(int(self.n_clusters), max(2, len(Z))))
        self.kmeans_ = KMeans(
            n_clusters=n_clusters,
            random_state=self.random_state,
            n_init=10,
        )
        self.kmeans_.fit(Z)
        return self

    def transform(self, X):
        X_arr = self._to_numeric_array(X)
        X_imp = np.where(np.isfinite(X_arr), X_arr, self.medians_)
        Z = (X_imp - self.means_) / self.stds_
        labels = self.kmeans_.predict(Z)
        one_hot = np.zeros((len(labels), self.kmeans_.n_clusters), dtype=float)
        one_hot[np.arange(len(labels)), labels] = 1.0
        return one_hot

    @staticmethod
    def _to_numeric_array(X):
        if isinstance(X, pd.DataFrame):
            arr = X.to_numpy(dtype=float)
        else:
            arr = np.asarray(X, dtype=float)
        if arr.ndim == 1:
            arr = arr.reshape(-1, 1)
        return arr


# ------------------------------------------------------------
# PREPROCESSOR
# ------------------------------------------------------------

def make_one_hot_encoder():
    # sklearn >= 1.2 uses sparse_output.
    try:
        return OneHotEncoder(handle_unknown="ignore", sparse_output=True)
    except TypeError:
        return OneHotEncoder(handle_unknown="ignore", sparse=True)


def build_preprocessor(X: pd.DataFrame):
    numeric_cols = X.select_dtypes(include=np.number).columns.tolist()
    categorical_cols = [
        c for c in X.columns
        if c not in numeric_cols
    ]

    # IDs should not normally be one-hot encoded.
    categorical_cols = [
        c for c in categorical_cols
        if not any(token in str(c).lower() for token in ["id", "identifier"])
    ]

    numeric_pipe = Pipeline([
        ("imputer", SimpleImputer(strategy="median")),
        ("scaler", StandardScaler()),
    ])

    categorical_pipe = Pipeline([
        ("imputer", SimpleImputer(strategy="most_frequent")),
        ("onehot", make_one_hot_encoder()),
    ])

    transformers = []
    if numeric_cols:
        transformers.append(("num", numeric_pipe, numeric_cols))
    if categorical_cols:
        transformers.append(("cat", categorical_pipe, categorical_cols))

    if not transformers:
        raise ValueError("No usable feature columns were found.")

    preprocessor = ColumnTransformer(
        transformers=transformers,
        remainder="drop",
    )
    return preprocessor


