def refit_best_model_and_predict_test(
    best_name,
    pipelines,
    all_labelled_features,
    all_y,
    test_features,
    group_col,
    selected_threshold,
):
    """
    Final model is fit on ALL labelled physicians only.

    Test physicians are only transformed/predicted after fitting.
    """
    X_all = all_labelled_features.drop(columns=[group_col], errors="ignore").copy()
    X_test = test_features.drop(columns=[group_col], errors="ignore").copy()

    final_model = clone(pipelines[best_name])
    final_model.fit(X_all, np.asarray(all_y, dtype=int))

    test_prob = final_model.predict_proba(X_test)[:, 1]
    test_pred = (test_prob >= selected_threshold).astype(int)

    result = test_features.copy()
    result["predicted_probability"] = test_prob
    result["predicted_class"] = test_pred
    result["rank"] = (
        result["predicted_probability"]
        .rank(method="first", ascending=False)
        .astype(int)
    )
    result = result.sort_values(
        ["predicted_probability"],
        ascending=False,
    ).reset_index(drop=True)

    result.to_csv(
        OUTPUT_DIR / "final_test_predictions_all_1502.csv",
        index=False,
    )

    top_n = min(200, len(result))
    result.head(top_n).to_csv(
        OUTPUT_DIR / f"top_{top_n}_targeted_physicians.csv",
        index=False,
    )

    print("\nFinal test prediction shape:", result.shape)
    print("Expected test size:", EXPECTED_TEST_SIZE)
    if len(result) != EXPECTED_TEST_SIZE:
        print(
            "WARNING: actual test size differs from expected 1502. "
            "Check your test file/selection rule."
        )

    print("\nTop 20 test predictions:")
    print(result.head(20).to_string(index=False))

    return final_model, result


