# SPLIT FIRST: THIS HAPPENS BEFORE EDA AND ALL FITTING
# ------------------------------------------------------------

def split_train_validation(
    df_labelled: pd.DataFrame,
    target_col: str,
    group_col: Optional[str],
) -> Tuple[pd.DataFrame, pd.DataFrame]:
    """
    Group-aware train/validation split.

    IMPORTANT: the test set is not passed here.
    """
    df_labelled = df_labelled.reset_index(drop=True)

    if group_col and group_col in df_labelled.columns:
        splitter = GroupShuffleSplit(
            n_splits=1,
            test_size=VALIDATION_SIZE,
            random_state=RANDOM_STATE,
        )
        train_idx, valid_idx = next(
            splitter.split(
                df_labelled,
                df_labelled[target_col],
                groups=df_labelled[group_col],
            )
        )
    else:
        # Fallback only when no group identifier exists.
        # Stratification maintains class balance.
        from sklearn.model_selection import train_test_split
        train_idx, valid_idx = train_test_split(
            np.arange(len(df_labelled)),
            test_size=VALIDATION_SIZE,
            random_state=RANDOM_STATE,
            stratify=df_labelled[target_col],
        )

    # ALWAYS use .iloc on pandas.
    train_df = df_labelled.iloc[np.asarray(train_idx, dtype=int)].copy().reset_index(drop=True)
    valid_df = df_labelled.iloc[np.asarray(valid_idx, dtype=int)].copy().reset_index(drop=True)

    return train_df, valid_df


