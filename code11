    print("Detected group:", group_col)

    if TEST_PATH:
        test = load_table(TEST_PATH)
        return labelled, test, target_col, group_col

    # Combined-file mode.
    if TEST_FLAG_COL and TEST_FLAG_COL in labelled.columns:
        mask_test = labelled[TEST_FLAG_COL] == TEST_FLAG_VALUE
        test = labelled.loc[mask_test].copy()
        labelled = labelled.loc[~mask_test].copy()
        return labelled, test, target_col, group_col

    # If target has missing values, assume those are the unlabeled test rows.
    if labelled[target_col].isna().any():
        mask_test = labelled[target_col].isna()
        test = labelled.loc[mask_test].drop(columns=[target_col], errors="ignore").copy()
        labelled = labelled.loc[~mask_test].copy()
        return labelled, test, target_col, group_col

    raise ValueError(
        "No separate TEST_PATH, TEST_FLAG_COL, or missing-target test rows were found. "
        "Set TEST_PATH or configure TEST_FLAG_COL."
    )


# ------------------------------------------------------------
# MAIN
# ------------------------------------------------------------

def main():
    print("=" * 90)
    print("STARTING END-TO-END LEAKAGE-SAFE PIPELINE")
    print("=" * 90)

    # --------------------------------------------------------
    # STEP 1: LOAD ONLY
    # No EDA, feature selection, scaling or model fitting here.
    # --------------------------------------------------------
    labelled_raw, test_raw, target_col, group_col = prepare_labelled_and_test()

    print("\nLabelled shape:", labelled_raw.shape)
    print("Test shape:", test_raw.shape)

    # Test target should not be used.
    if target_col in test_raw.columns:
        test_raw = test_raw.drop(columns=[target_col])

    # --------------------------------------------------------
    # STEP 2: ENCODE TARGET
    # Still no EDA/model fitting.
    # --------------------------------------------------------
    y_encoded, target_mapping = encode_binary_target(labelled_raw[target_col])
    labelled = labelled_raw.copy()
    labelled[target_col] = y_encoded

    with open(OUTPUT_DIR / "target_mapping.json", "w", encoding="utf-8") as f:
        json.dump(target_mapping, f, indent=2)

    # --------------------------------------------------------
    # STEP 3: SPLIT BEFORE EDA
    # --------------------------------------------------------
    train_df, valid_df = split_train_validation(
        labelled,
        target_col,
        group_col,
    )

    print("\n" + "=" * 90)
    print("TRAIN / VALIDATION SPLIT COMPLETED BEFORE EDA")
    print("=" * 90)
    print("Train:", train_df.shape)
    print("Validation:", valid_df.shape)
    print("Train target distribution:")
    print(train_df[target_col].value_counts(normalize=True))
    print("Validation target distribution:")
    print(valid_df[target_col].value_counts(normalize=True))

    # Check group overlap.
    if group_col and group_col in train_df.columns and group_col in valid_df.columns:
        overlap = set(train_df[group_col].dropna()) & set(valid_df[group_col].dropna())
        print("Group overlap between train and validation:", len(overlap))
        if overlap:
            raise RuntimeError(
                "LEAKAGE CHECK FAILED: groups overlap between train and validation."
            )

    # --------------------------------------------------------
    # STEP 4: EDA ONLY ON TRAINING SPLIT
    # --------------------------------------------------------
    run_simple_eda(train_df, target_col, group_col)

    # --------------------------------------------------------
    # STEP 5: FEATURE ENGINEERING
    # Engineer each split independently.
    # No target-derived features.
    # --------------------------------------------------------
    print("\n" + "=" * 90)
    print("FEATURE ENGINEERING")
    print("=" * 90)

    train_fe = advanced_feature_engineering(train_df, target_col, group_col)
    valid_fe = advanced_feature_engineering(valid_df, target_col, group_col)
    test_fe = advanced_feature_engineering(test_raw, target_col, group_col)

    # Align columns without using validation/test to learn values.
    # Since the engineering is deterministic, the same generated feature names
    # are aligned safely.
    feature_union = [
        c for c in train_fe.columns
        if c != target_col
    ]

    # Keep only training-derived feature names.
    train_fe = train_fe[[c for c in train_fe.columns if c == target_col or c in feature_union]].copy()
    valid_fe = valid_fe.reindex(columns=[c for c in valid_fe.columns if c != target_col and c in feature_union] + [target_col if target_col in valid_fe.columns else target_col])
    test_fe = test_fe.reindex(columns=[c for c in test_fe.columns if c in feature_union])

    # Reindex validation to EXACT train feature columns.
    train_X = train_fe.drop(columns=[target_col], errors="ignore").copy()
    valid_X = valid_fe.drop(columns=[target_col], errors="ignore").reindex(columns=train_X.columns).copy()
    test_X = test_fe.reindex(columns=train_X.columns).copy()

    y_train = train_fe[target_col].astype(int)
    y_valid = valid_fe[target_col].astype(int)

    # --------------------------------------------------------
    # STEP 6: CORRELATION / VIF ON TRAIN ONLY
    # --------------------------------------------------------
    run_correlation_and_vif(train_fe, target_col)

    # --------------------------------------------------------
    # STEP 7: MUTUAL INFORMATION ON TRAIN ONLY
    # --------------------------------------------------------
    run_mutual_information(train_X, y_train)

    # --------------------------------------------------------
    # STEP 8: CV ON TRAINING SPLIT ONLY
    # Validation is not used to tune CV models.
    # --------------------------------------------------------
    cv_input = train_fe.copy()
    pipelines, summary, oof_probabilities = cross_validate_models(
        cv_input,
        y_train,
        group_col,
    )

    plot_model_curves(y_train, oof_probabilities)

    # --------------------------------------------------------
    # STEP 9: VALIDATION EVALUATION
    # --------------------------------------------------------
    fitted_models, validation_df = fit_final_models(
        pipelines,
        train_fe,
        y_train,
        valid_fe,
        y_valid,
        group_col,
    )

    best_name = choose_best_model(summary, validation_df)

    # Get the selected threshold for best model.
    best_threshold = float(
        validation_df.loc[
            validation_df["model"] == best_name,
            "threshold"
        ].iloc[0]
    )

    # --------------------------------------------------------
    # STEP 10: FINAL FIT ON ALL LABELLED DATA
    # This is the first point where train + validation are combined.
    # --------------------------------------------------------
    all_labelled_fe = advanced_feature_engineering(
        labelled,
        target_col,
        group_col,
    )

    # Ensure exactly the same feature columns used by the training model.
    all_X = all_labelled_fe.drop(columns=[target_col], errors="ignore")
    all_X = all_X.reindex(columns=train_X.columns)

    # Test is transformed independently; no test fitting.
    final_test_X = test_fe.reindex(columns=train_X.columns)

    final_model, test_predictions = refit_best_model_and_predict_test(
        best_name,
        pipelines,
        all_X.assign(**{target_col: all_labelled_fe[target_col].to_numpy()}),
        all_labelled_fe[target_col].astype(int),
        final_test_X,
        group_col,
        best_threshold,
    )

    # --------------------------------------------------------
    # STEP 11: FINAL AUDIT
    # --------------------------------------------------------
    audit = {
        "target_column": target_col,
        "group_column": group_col,
        "labelled_rows": int(len(labelled)),
        "train_rows": int(len(train_df)),
        "validation_rows": int(len(valid_df)),
        "test_rows": int(len(test_raw)),
        "expected_test_rows": int(EXPECTED_TEST_SIZE),
        "group_overlap_train_validation": None,
        "test_target_used_for_fit": False,
        "smotetomek_available": bool(IMBLEARN_AVAILABLE),
        "xgboost_available": bool(XGBOOST_AVAILABLE),
        "best_model": best_name,
        "selected_threshold": best_threshold,
        "momentum_columns": [
            c for c in train_X.columns
            if "momentum" in str(c).lower()
        ],
    }

    if group_col and group_col in train_df.columns and group_col in valid_df.columns:
        audit["group_overlap_train_validation"] = int(
            len(
                set(train_df[group_col].dropna())
                & set(valid_df[group_col].dropna())
            )
        )

    with open(OUTPUT_DIR / "pipeline_audit.json", "w", encoding="utf-8") as f:
        json.dump(audit, f, indent=2, default=str)

    print("\n" + "=" * 90)
    print("PIPELINE COMPLETED")
    print("=" * 90)
    print("Best model:", best_name)
    print("Selected threshold:", best_threshold)
    print("Test predictions:", OUTPUT_DIR / "final_test_predictions_all_1502.csv")
    print("Top-200 file:", OUTPUT_DIR / "top_200_targeted_physicians.csv")
    print("Model comparison:", OUTPUT_DIR / "model_comparison_summary.csv")
    print("ROC curve:", OUTPUT_DIR / "roc_auc_comparison.png")
    print("PR curve:", OUTPUT_DIR / "pr_auc_comparison.png")
    print("\nIMPORTANT: If the actual test file does not contain exactly 1502 rows,")
    print("the script will warn rather than silently dropping/creating physicians.")


if __name__ == "__main__":
    main()
