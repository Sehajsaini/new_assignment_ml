def _numeric_series(df: pd.DataFrame, col: str) -> Optional[pd.Series]:
    if col not in df.columns:
        return None
    s = pd.to_numeric(df[col], errors="coerce")
    if s.notna().sum() == 0:
        return None
    return s


def _find_q_columns(df: pd.DataFrame, base_patterns: List[str], periods: List[int]) -> Dict[int, str]:
    """
    Find columns such as Q7, Q8, Q9, Q10 or rx_Q7/rx_Q8/etc.
    """
    result = {}
    cols = list(df.columns)

    for p in periods:
        candidates = []
        for c in cols:
            cl = str(c).strip().lower()
            for base in base_patterns:
                b = base.lower()
                patterns = [
                    rf"^{re.escape(b)}[_\-\s]*q{p}$",
                    rf"^{re.escape(b)}[_\-\s]*{p}$",
                    rf"^q{p}[_\-\s]*{re.escape(b)}$",
                    rf"^{re.escape(b)}[_\-\s]*quarter[_\-\s]*{p}$",
                ]
                if any(re.search(pt, cl) for pt in patterns):
                    candidates.append(c)
        if candidates:
            result[p] = candidates[0]

    # Generic Q7/Q8/Q9/Q10 if no base pattern matched.
    for p in periods:
        if p in result:
            continue
        exact = [c for c in cols if str(c).strip().lower() in {f"q{p}", str(p)}]
        if exact:
            result[p] = exact[0]

    return result


def add_momentum_features(df: pd.DataFrame) -> pd.DataFrame:
    """
    Momentum features over Q7-Q10.

    The formula is:
        momentum_Q10_Q7 = Q10 - Q7
        recent_momentum = mean(Q9,Q10) - mean(Q7,Q8)
        momentum_acceleration = (Q10-Q9) - (Q8-Q7)
        slope_Q7_Q10 = linear slope across available periods

    These are feature-only calculations. They do not use the target.
    """
    out = df.copy()

    periods = [7, 8, 9, 10]

    # Try generic names first.
    patterns = [
        ["rx", "rxcount", "rx_count", "prescription", "prescriptions"],
        ["adoption", "adopt"],
        ["sales", "volume"],
        ["count"],
    ]

    series_map = None
    for bases in patterns:
        found = _find_q_columns(out, bases, periods)
        if len(found) >= 3:
            series_map = found
            break

    if series_map is None:
        found = {}
        for p in periods:
            # columns containing q7/q8/etc and likely activity/count terms
            candidates = [
                c for c in out.columns
                if re.search(rf"(^|[_\-\s])q{p}($|[_\-\s])", str(c).lower())
            ]
            if candidates:
                # Prefer numeric candidate.
                numeric_candidates = [
                    c for c in candidates
                    if pd.api.types.is_numeric_dtype(out[c])
                ]
                found[p] = numeric_candidates[0] if numeric_candidates else candidates[0]
        if len(found) >= 3:
            series_map = found

    if series_map is None:
        print("\nMomentum feature note: Q7-Q10 longitudinal columns were not detected;")
        print("the script continues without fabricating a momentum variable.")
        return out

    q = {}
    for p, c in series_map.items():
        q[p] = pd.to_numeric(out[c], errors="coerce")

    def safe_mean(items):
        return pd.concat(items, axis=1).mean(axis=1)

    if 7 in q and 10 in q:
        out["momentum_Q10_minus_Q7"] = q[10] - q[7]

    if 7 in q and 8 in q and 9 in q and 10 in q:
        early = safe_mean([q[7], q[8]])
        late = safe_mean([q[9], q[10]])
        out["recent_momentum"] = late - early
        out["momentum_acceleration"] = (q[10] - q[9]) - (q[8] - q[7])
        x = np.array([7.0, 8.0, 9.0, 10.0])

        values = pd.concat([q[7], q[8], q[9], q[10]], axis=1).to_numpy(dtype=float)
        slopes = np.full(len(values), np.nan)
        for i, row in enumerate(values):
            mask = np.isfinite(row)
            if mask.sum() >= 2:
                slopes[i] = np.polyfit(x[mask], row[mask], 1)[0]
        out["momentum_slope_Q7_Q10"] = slopes

    if 9 in q and 10 in q:
        out["Q10_vs_Q9_change"] = q[10] - q[9]
        denominator = q[9].abs().replace(0, np.nan)
        out["Q10_vs_Q9_growth_rate"] = (q[10] - q[9]) / denominator

    return out


def advanced_feature_engineering(
    df: pd.DataFrame,
    target_col: str,
    group_col: Optional[str],
) -> pd.DataFrame:
    """
    Feature engineering uses only columns in the current dataframe.
    No target-derived feature is created.

    Because this transformation is deterministic and does not learn from
    other rows, it is safe to apply separately to train/validation/test.
    """
    out = df.copy()

    # Remove target from feature engineering calculations.
    feature_cols = [c for c in out.columns if c != target_col]

    numeric_cols = [
        c for c in feature_cols
        if pd.api.types.is_numeric_dtype(out[c])
    ]

    # Remove obvious IDs from aggregate calculations.
    numeric_signal_cols = [
        c for c in numeric_cols
        if not any(token in str(c).lower() for token in ["id", "zip", "zipcode", "pincode"])
    ]

    # Row-wise robust aggregate features.
    if numeric_signal_cols:
        Xn = out[numeric_signal_cols].apply(pd.to_numeric, errors="coerce")
        out["feature_numeric_count"] = Xn.notna().sum(axis=1)
        out["feature_numeric_mean"] = Xn.mean(axis=1)
        out["feature_numeric_std"] = Xn.std(axis=1)
        out["feature_numeric_min"] = Xn.min(axis=1)
        out["feature_numeric_max"] = Xn.max(axis=1)

    # Common ratio features when the columns exist.
    def ratio(new_name, numerator_candidates, denominator_candidates):
        num_col = detect_column(out, numerator_candidates, "numerator")
        den_col = detect_column(out, denominator_candidates, "denominator")
        if num_col and den_col:
            num = pd.to_numeric(out[num_col], errors="coerce")
            den = pd.to_numeric(out[den_col], errors="coerce").replace(0, np.nan)
            out[new_name] = num / den

    ratio(
        "processing_fee_rate",
        ["processing_fee"],
        ["loan_amount", "sanction_amount"],
    )
    ratio(
        "gst_rate",
        ["gst"],
        ["processing_fee", "loan_amount"],
    )
    ratio(
        "net_disbursement_rate",
        ["net_disbursement"],
        ["loan_amount", "sanction_amount"],
    )
    ratio(
        "dpd_per_delinquent_month",
        ["total_dpd"],
        ["delinquent_months"],
    )
    ratio(
        "closed_to_open_account_ratio",
        ["number_of_closed_accounts"],
        ["number_of_open_accounts"],
    )
    ratio(
        "dependants_per_open_account",
        ["number_of_dependants"],
        ["number_of_open_accounts"],
    )

    # Tenure/address stability style features.
    if "years_at_current_address" in out.columns and "age" in out.columns:
        age = pd.to_numeric(out["age"], errors="coerce")
        years = pd.to_numeric(out["years_at_current_address"], errors="coerce")
        out["address_stability_ratio"] = years / age.replace(0, np.nan)

    # Credit pressure.
    if "credit_utilization_ratio" in out.columns:
        cur = pd.to_numeric(out["credit_utilization_ratio"], errors="coerce")
        out["credit_utilization_sq"] = cur ** 2
        out["credit_utilization_log"] = np.log1p(cur.clip(lower=0))

    # Enquiry intensity relative to open accounts.
    ratio(
        "enquiry_per_open_account",
        ["enquiry_count"],
        ["number_of_open_accounts"],
    )

    # DPD risk transform.
    if "total_dpd" in out.columns:
        dpd = pd.to_numeric(out["total_dpd"], errors="coerce")
        out["total_dpd_log1p"] = np.log1p(dpd.clip(lower=0))
        out["any_dpd_flag"] = (dpd.fillna(0) > 0).astype(int)

    # Loan amount transforms.
    for c in ["loan_amount", "sanction_amount", "principal_outstanding", "bank_balance_at_application"]:
        if c in out.columns:
            s = pd.to_numeric(out[c], errors="coerce")
            out[f"{c}_log1p"] = np.log1p(s.clip(lower=0))

    # --------------------------------------------------------
    # Longitudinal momentum — explicitly requested
    # --------------------------------------------------------
    out = add_momentum_features(out)

    # General Q7-Q10 longitudinal aggregates.
    q_periods = {}
    for p in [7, 8, 9, 10]:
        candidates = [
            c for c in out.columns
            if re.search(rf"(^|[_\-\s])q{p}($|[_\-\s])", str(c).lower())
        ]
        if candidates:
            numeric_candidates = [
                c for c in candidates
                if pd.api.types.is_numeric_dtype(out[c])
            ]
            if numeric_candidates:
                q_periods[p] = numeric_candidates[0]

    if len(q_periods) >= 3:
        qmat = pd.concat(
            [pd.to_numeric(out[c], errors="coerce") for c in q_periods.values()],
            axis=1,
        )
        out["Q7_Q10_activity_mean"] = qmat.mean(axis=1)
        out["Q7_Q10_activity_std"] = qmat.std(axis=1)
        out["Q7_Q10_activity_max"] = qmat.max(axis=1)
        out["Q7_Q10_activity_min"] = qmat.min(axis=1)

    # Group-size feature is unsupervised and safe.
    if group_col and group_col in out.columns:
        counts = out[group_col].value_counts(dropna=False)
        out["group_observation_count"] = out[group_col].map(counts).astype(float)

    # Clean infinities.
    out = out.replace([np.inf, -np.inf], np.nan)

    return out


