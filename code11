def choose_best_model(summary, validation_df):
    """
    Primary objective: PR-AUC because the task is imbalanced.
    Secondary: ROC-AUC, recall, F1.

    The threshold is chosen separately with specificity >= 0.70 where possible.
    """
    if summary.empty:
        raise ValueError("No model results available.")

    ranked = summary.copy()
    ranked = ranked.sort_values(
        ["pr_auc_mean", "roc_auc_mean", "recall_mean", "f1_mean"],
        ascending=False,
    )

    best_name = ranked.iloc[0]["model"]
    print("\nBEST MODEL BY OOF PR-AUC:", best_name)
    return str(best_name)


