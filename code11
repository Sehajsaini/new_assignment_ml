# FINAL FIT + VALIDATION REPORT
# ------------------------------------------------------------

def fit_final_models(
    pipelines,
    X_train,
    y_train,
    X_valid,
    y_valid,
    group_col,
):
    fitted = {}
    validation_rows = []

    model_X_train = X_train.drop(columns=[group_col], errors="ignore").copy()
    model_X_valid = X_valid.drop(columns=[group_col], errors="ignore").copy()

    for name, pipe in pipelines.items():
        print("\nFitting final model on training split:", name)
        model = clone(pipe)
        model.fit(model_X_train, np.asarray(y_train, dtype=int))

        prob = model.predict_proba(model_X_valid)[:, 1]

        threshold, threshold_table = threshold_analysis(
            y_valid,
            prob,
            name,
        )

        m50 = evaluate_binary(y_valid, prob, 0.50)
        msel = evaluate_binary(y_valid, prob, threshold)

        row = {
            "model": name,
            "threshold": threshold,
            **{f"validation_50_{k}": v for k, v in m50.items()},
            **{f"validation_selected_{k}": v for k, v in msel.items()},
        }
        validation_rows.append(row)

        print("\nClassification report at 0.50:")
        print(classification_report(
            y_valid,
            (prob >= 0.50).astype(int),
            digits=4,
            zero_division=0,
        ))

        print("Confusion matrix at 0.50:")
        print(confusion_matrix(y_valid, (prob >= 0.50).astype(int), labels=[0, 1]))

        save_feature_importance(model, model_X_train, y_train, name)
        permutation_importance_validation(
            model,
            model_X_valid,
            y_valid,
            name,
            group_col,
        )

        fitted[name] = {
            "pipeline": model,
            "prob_valid": prob,
            "threshold": threshold,
        }

    val_df = pd.DataFrame(validation_rows)
    val_df.to_csv(OUTPUT_DIR / "validation_model_metrics.csv", index=False)

    return fitted, val_df


