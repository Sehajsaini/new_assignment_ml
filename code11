def save_feature_importance(fitted_pipeline, X_train, y_train, model_name):
    try:
        pre = fitted_pipeline.named_steps["preprocess"]
        model = fitted_pipeline.named_steps["model"]

        feature_names = pre.get_feature_names_out()

        if hasattr(model, "coef_"):
            vals = np.asarray(model.coef_).ravel()
            imp = pd.DataFrame({
                "feature": feature_names,
                "coefficient": vals,
                "abs_importance": np.abs(vals),
            }).sort_values("abs_importance", ascending=False)
            imp.to_csv(
                OUTPUT_DIR / f"{safe_filename(model_name)}_coefficients.csv",
                index=False,
            )

        elif hasattr(model, "feature_importances_"):
            vals = np.asarray(model.feature_importances_)
            imp = pd.DataFrame({
                "feature": feature_names,
                "importance": vals,
            }).sort_values("importance", ascending=False)
            imp.to_csv(
                OUTPUT_DIR / f"{safe_filename(model_name)}_feature_importance.csv",
                index=False,
            )

    except Exception as e:
        print(f"Feature importance warning for {model_name}:", e)


def permutation_importance_validation(
    fitted_pipeline,
    X_valid,
    y_valid,
    model_name,
    group_col,
):
    try:
        Xv = X_valid.drop(columns=[group_col], errors="ignore")
        result = permutation_importance(
            fitted_pipeline,
            Xv,
            y_valid,
            scoring="average_precision",
            n_repeats=5,
            random_state=RANDOM_STATE,
            n_jobs=-1,
        )
        names = Xv.columns
        imp = pd.DataFrame({
            "feature": names,
            "importance_mean": result.importances_mean,
            "importance_std": result.importances_std,
        }).sort_values("importance_mean", ascending=False)
        imp.to_csv(
            OUTPUT_DIR / f"{safe_filename(model_name)}_validation_permutation_importance.csv",
            index=False,
        )
    except Exception as e:
        print("Permutation importance warning:", e)


