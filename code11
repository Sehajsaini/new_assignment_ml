      A) separate labelled DATA_PATH + separate TEST_PATH
      B) one combined file where target is missing for test rows
      C) one combined file with TEST_FLAG_COL
    """
    labelled = load_table(DATA_PATH)

    target_col = detect_target(labelled)
    group_col = detect_group(labelled)

