# MODELS
# ------------------------------------------------------------

def build_models(preprocessor):
    models = {}

    models["Logistic Regression"] = LogisticRegression(
        max_iter=3000,
        class_weight="balanced",
        solver="liblinear",
        random_state=RANDOM_STATE,
    )

    models["Random Forest"] = RandomForestClassifier(
        n_estimators=500,
        max_depth=None,
        min_samples_leaf=2,
        max_features="sqrt",
        class_weight="balanced_subsample",
        n_jobs=-1,
        random_state=RANDOM_STATE,
        oob_score=True,
        bootstrap=True,
    )

    models["Gradient Boosting"] = GradientBoostingClassifier(
        n_estimators=250,
        learning_rate=0.03,
        max_depth=3,
        min_samples_leaf=5,
        subsample=0.85,
        random_state=RANDOM_STATE,
    )

    if XGBOOST_AVAILABLE:
        # Do NOT pass early_stopping_rounds to fit().
        models["XGBoost"] = XGBClassifier(
            n_estimators=500,
            max_depth=5,
            learning_rate=0.03,
            subsample=0.85,
            colsample_bytree=0.85,
            min_child_weight=3,
            gamma=0.0,
            reg_alpha=0.1,
            reg_lambda=2.0,
            objective="binary:logistic",
            eval_metric="logloss",
            tree_method="hist",
            n_jobs=-1,
            random_state=RANDOM_STATE,
        )
    else:
        print("\nXGBoost unavailable; continuing with LR, RF and Gradient Boosting.")
        print("XGBoost import error:", XGBOOST_ERROR)

    pipelines = {}
    for name, estimator in models.items():
        if IMBLEARN_AVAILABLE:
            # SMOTETomek occurs AFTER preprocessing and is fitted separately
            # inside each CV fold.
            pipelines[name] = ImbPipeline([
                ("preprocess", preprocessor),
                ("balance", SMOTETomek(random_state=RANDOM_STATE)),
                ("model", estimator),
            ])
        else:
            pipelines[name] = Pipeline([
                ("preprocess", preprocessor),
                ("model", estimator),
            ])

    return pipelines


# ------------------------------------------------------------
# GROUP-AWARE CV
# ------------------------------------------------------------

def get_cv_splits(
    X: pd.DataFrame,
    y: pd.Series,
    group_col: Optional[str],
):
    """
    Prefer StratifiedGroupKFold when group information exists.
    Otherwise use StratifiedKFold.

    The group column is removed from model predictors separately.
    """
    if group_col and group_col in X.columns:
        try:
            cv = StratifiedGroupKFold(
                n_splits=N_SPLITS,
                shuffle=True,
                random_state=RANDOM_STATE,
            )
            groups = X[group_col].to_numpy()
            dummy_X = X.drop(columns=[group_col])
            splits = list(cv.split(dummy_X, y, groups=groups))
            return splits, "StratifiedGroupKFold"
        except Exception as e:
            print("StratifiedGroupKFold unavailable; using GroupKFold-style split:", e)
            from sklearn.model_selection import GroupKFold
            cv = GroupKFold(n_splits=N_SPLITS)
            groups = X[group_col].to_numpy()
            dummy_X = X.drop(columns=[group_col])
            splits = list(cv.split(dummy_X, y, groups=groups))
            return splits, "GroupKFold"

    cv = StratifiedKFold(
        n_splits=N_SPLITS,
        shuffle=True,
        random_state=RANDOM_STATE,
    )
    splits = list(cv.split(X, y))
    return splits, "StratifiedKFold"


# ------------------------------------------------------------
# METRICS
# ------------------------------------------------------------

def specificity_score(y_true, y_pred):
    cm = confusion_matrix(y_true, y_pred, labels=[0, 1])
    tn, fp, fn, tp = cm.ravel()
    return tn / (tn + fp) if (tn + fp) else np.nan


def evaluate_binary(y_true, prob, threshold=0.50) -> Dict:
    prob = np.asarray(prob, dtype=float)
    pred = (prob >= threshold).astype(int)

    result = {
        "accuracy": accuracy_score(y_true, pred),
        "precision": precision_score(y_true, pred, zero_division=0),
        "recall": recall_score(y_true, pred, zero_division=0),
        "specificity": specificity_score(y_true, pred),
        "f1": f1_score(y_true, pred, zero_division=0),
        "balanced_accuracy": balanced_accuracy_score(y_true, pred),
        "mcc": matthews_corrcoef(y_true, pred),
        "roc_auc": np.nan,
        "pr_auc": np.nan,
        "log_loss": np.nan,
    }

    try:
        result["roc_auc"] = roc_auc_score(y_true, prob)
    except Exception:
        pass

    try:
        result["pr_auc"] = average_precision_score(y_true, prob)
    except Exception:
        pass

    try:
        result["log_loss"] = log_loss(y_true, np.column_stack([1-prob, prob]))
    except Exception:
        pass

    return result


# ------------------------------------------------------------
# CROSS-VALIDATION
# ------------------------------------------------------------

def cross_validate_models(
    X: pd.DataFrame,
    y: pd.Series,
    group_col: Optional[str],
):
    """
    Fit every model from scratch in every fold.

    No preprocessing, SMOTE, KMeans, scaling or model fitting is performed
    on the held-out fold.
    """
    print("\n" + "=" * 90)
    print("CROSS-VALIDATION")
    print("=" * 90)

    model_X = X.drop(columns=[group_col], errors="ignore").copy()

    preprocessor = build_preprocessor(model_X)
    pipelines = build_models(preprocessor)

    splits, cv_name = get_cv_splits(X, y, group_col)
    print(f"CV strategy: {cv_name}")
    print(f"Number of folds: {len(splits)}")

    all_rows = []
    oof_probabilities = {}
    oof_truth = {}

    for model_name, pipe in pipelines.items():
        print(f"\n>>> {model_name}")

        oof = np.full(len(X), np.nan)

        for fold, (tr_idx, va_idx) in enumerate(splits, start=1):
            tr_idx = np.asarray(tr_idx, dtype=int)
            va_idx = np.asarray(va_idx, dtype=int)

            # IMPORTANT: .iloc, never X[np_array] if X might be Arrow-backed.
            Xtr = model_X.iloc[tr_idx].copy()
            Xva = model_X.iloc[va_idx].copy()
            ytr = np.asarray(y.iloc[tr_idx], dtype=int)
            yva = np.asarray(y.iloc[va_idx], dtype=int)

            fitted = clone(pipe)
            fitted.fit(Xtr, ytr)

            prob = fitted.predict_proba(Xva)[:, 1]
            oof[va_idx] = prob

            m = evaluate_binary(yva, prob, threshold=0.50)
            m.update({
                "model": model_name,
                "fold": fold,
                "n_train": len(tr_idx),
                "n_valid": len(va_idx),
            })
            all_rows.append(m)

            print(
                f"Fold {fold}: "
                f"ROC-AUC={m['roc_auc']:.4f}, "
                f"PR-AUC={m['pr_auc']:.4f}, "
                f"Recall={m['recall']:.4f}, "
                f"Specificity={m['specificity']:.4f}, "
                f"F1={m['f1']:.4f}"
            )

        oof_probabilities[model_name] = oof
        oof_truth[model_name] = np.asarray(y, dtype=int)

        overall = evaluate_binary(y, oof, threshold=0.50)
        overall["model"] = model_name
        overall["fold"] = "OOF"
        overall["n_train"] = np.nan
        overall["n_valid"] = len(y)
        all_rows.append(overall)

    cv_results = pd.DataFrame(all_rows)
    cv_results.to_csv(OUTPUT_DIR / "cv_all_fold_metrics.csv", index=False)

    summary = (
        cv_results[cv_results["fold"] != "OOF"]
        .groupby("model")
        .agg(
            roc_auc_mean=("roc_auc", "mean"),
            roc_auc_std=("roc_auc", "std"),
            pr_auc_mean=("pr_auc", "mean"),
            pr_auc_std=("pr_auc", "std"),
            accuracy_mean=("accuracy", "mean"),
            precision_mean=("precision", "mean"),
            recall_mean=("recall", "mean"),
            specificity_mean=("specificity", "mean"),
            f1_mean=("f1", "mean"),
            balanced_accuracy_mean=("balanced_accuracy", "mean"),
            mcc_mean=("mcc", "mean"),
            log_loss_mean=("log_loss", "mean"),
        )
        .reset_index()
        .sort_values(["pr_auc_mean", "roc_auc_mean"], ascending=False)
    )

    summary.to_csv(OUTPUT_DIR / "model_comparison_summary.csv", index=False)

    print("\nMODEL COMPARISON:")
    print(summary.to_string(index=False))

    return pipelines, summary, oof_probabilities


