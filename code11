# ------------------------------------------------------------
# THRESHOLD ANALYSIS
# ------------------------------------------------------------

def threshold_analysis(y, prob, model_name):
    rows = []
    for threshold in np.arange(0.10, 0.91, 0.05):
        m = evaluate_binary(y, prob, float(threshold))
        m["threshold"] = round(float(threshold), 2)
        rows.append(m)

    out = pd.DataFrame(rows)
    out.to_csv(
        OUTPUT_DIR / f"{safe_filename(model_name)}_threshold_analysis.csv",
        index=False,
    )

    # Preferred constraint from the earlier approach:
    # maximize positive-class recall while maintaining negative-class
    # recall/specificity above 0.70.
    feasible = out[out["specificity"] >= 0.70].copy()

    if not feasible.empty:
        best = feasible.sort_values(
            ["recall", "f1", "pr_auc"],
            ascending=False,
        ).iloc[0]
    else:
        best = out.sort_values(
            ["balanced_accuracy", "f1"],
            ascending=False,
        ).iloc[0]

    print(
        f"\n{model_name} selected threshold: {best['threshold']:.2f} "
        f"(specificity={best['specificity']:.4f}, "
        f"recall={best['recall']:.4f}, "
        f"F1={best['f1']:.4f})"
    )

    return float(best["threshold"]), out


def safe_filename(x: str) -> str:
    return re.sub(r"[^A-Za-z0-9_.-]+", "_", x)


