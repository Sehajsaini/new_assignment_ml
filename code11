def load_table(path: str) -> pd.DataFrame:
    """
    Load CSV/XLSX/XLS/Parquet/Feather/JSON and immediately materialize
    Arrow-backed data into an ordinary pandas DataFrame.

    This is the key correction for:
        TypeError: only integer scalar arrays can be converted to a scalar index
    """
    if not path:
        raise ValueError("DATA_PATH is empty. Set DATA_PATH to your labelled file.")

    p = Path(path)
    if not p.exists():
        raise FileNotFoundError(f"File not found: {p.resolve()}")

    suffix = p.suffix.lower()

    if suffix == ".csv":
        df = pd.read_csv(p)
    elif suffix in (".xlsx", ".xls"):
        df = pd.read_excel(p)
    elif suffix in (".parquet", ".pq"):
        # pandas may use PyArrow here. Force a pandas materialization.
        df = pd.read_parquet(p)
    elif suffix == ".feather":
        df = pd.read_feather(p)
    elif suffix == ".json":
        df = pd.read_json(p)
    else:
        raise ValueError(
            f"Unsupported file type '{suffix}'. Use CSV, XLSX, XLS, Parquet, Feather or JSON."
        )

    # Force a normal pandas object and reset the index.
    df = pd.DataFrame(df).copy()
    df = df.reset_index(drop=True)

    # Normalize duplicate column names.
    df.columns = make_unique_columns([str(c).strip() for c in df.columns])

    return df


def make_unique_columns(cols: List[str]) -> List[str]:
    seen = {}
    out = []
    for c in cols:
        if c not in seen:
            seen[c] = 0
            out.append(c)
        else:
            seen[c] += 1
            out.append(f"{c}__dup{seen[c]}")
    return out


def detect_column(df: pd.DataFrame, candidates: List[str], kind: str) -> Optional[str]:
    lower_map = {str(c).strip().lower(): c for c in df.columns}
    for c in candidates:
        if c in df.columns:
            return c
        if c.lower() in lower_map:
            return lower_map[c.lower()]
    return None


def detect_target(df: pd.DataFrame) -> str:
    if TARGET_COL is not None:
        if TARGET_COL not in df.columns:
            raise KeyError(f"TARGET_COL='{TARGET_COL}' is not in the dataset.")
        return TARGET_COL

    detected = detect_column(df, TARGET_CANDIDATES, "target")
    if detected is not None:
        return detected

    # Last-resort heuristic: a binary column with a target-like name.
    for c in df.columns:
        name = str(c).lower()
        if any(k in name for k in ["target", "label", "outcome", "adopt", "class"]):
            vals = pd.Series(df[c]).dropna().unique()
            if len(vals) == 2:
                return c

    raise KeyError(
        "Could not automatically identify the target. "
        "Set TARGET_COL at the top of the script to the exact labelled outcome column."
    )


def detect_group(df: pd.DataFrame) -> Optional[str]:
    if GROUP_COL is not None:
        if GROUP_COL not in df.columns:
            raise KeyError(f"GROUP_COL='{GROUP_COL}' is not in the dataset.")
        return GROUP_COL
    return detect_column(df, GROUP_CANDIDATES, "group")


