def run_mutual_information(train_X, train_y):
    try:
        X = train_X.select_dtypes(include=np.number).copy()
        X = X.replace([np.inf, -np.inf], np.nan)
        X = X.fillna(X.median(numeric_only=True))

        if X.shape[1] == 0:
            return

        scores = mutual_info_classif(
            X.to_numpy(),
            np.asarray(train_y),
            random_state=RANDOM_STATE,
        )
        out = pd.DataFrame({
            "feature": X.columns,
            "mutual_information": scores,
        }).sort_values("mutual_information", ascending=False)
        out.to_csv(OUTPUT_DIR / "training_mutual_information.csv", index=False)
