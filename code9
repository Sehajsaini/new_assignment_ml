SMOOTHING_ALPHA = 20


territory_train_stats[
    "territory_adoption_rate"
] = (

    territory_train_stats[
        "sum"
    ]

    +

    SMOOTHING_ALPHA
    *
    global_adoption_rate

) / (

    territory_train_stats[
        "count"
    ]

    +

    SMOOTHING_ALPHA

)


territory_map = territory_train_stats[
    "territory_adoption_rate"
].to_dict()


# ================================================================
# 34. LEAKAGE-SAFE TERRITORY RATE
# ================================================================

def calculate_loo_territory_rate(
    row
):

    territory = row[
        "territory_code"
    ]


    if territory not in territory_train_stats.index:

        return global_adoption_rate


    total_n = territory_train_stats.loc[
        territory,
        "count"
    ]


    total_adopters = territory_train_stats.loc[
        territory,
        "sum"
    ]


    n_without_current = (
        total_n - 1
    )


    adopters_without_current = (

        total_adopters
        -
        row["adopted"]

    )


    return (

        adopters_without_current
        +
        SMOOTHING_ALPHA
        *
        global_adoption_rate

    ) / (

        n_without_current
        +
        SMOOTHING_ALPHA

    )


train_data[
    "territory_adoption_rate"
] = train_data.apply(
