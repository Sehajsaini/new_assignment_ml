# 18. EDA — OUTLIER DETECTION USING IQR
# ================================================================

outlier_rows = []


for col in numeric_behavior:

    if col not in df.columns:

        continue

    x = df[col].dropna()

    Q1 = x.quantile(0.25)

    Q3 = x.quantile(0.75)

    IQR = Q3 - Q1

    lower = Q1 - 1.5 * IQR

    upper = Q3 + 1.5 * IQR

    outliers = (
        (x < lower)
        |
        (x > upper)
    ).sum()

    outlier_rows.append({

        "feature": col,

        "Q1": Q1,

        "Q3": Q3,

        "IQR": IQR,

        "lower_bound": lower,

        "upper_bound": upper,

        "outlier_count": outliers,

        "outlier_percentage":
            100 * outliers / len(x)

    })


outlier_summary = pd.DataFrame(
