def decile_lift(
    y_true,
    probabilities
):

    temp = pd.DataFrame({

        "actual":
            np.asarray(y_true),

        "probability":
            np.asarray(probabilities)

    })


    temp["decile"] = pd.qcut(

        temp["probability"],

        10,

        labels=False,

        duplicates="drop"

    )


    # Highest probability = decile 1
    temp["decile"] = (
        10
        -
        temp["decile"]
    )


    overall_rate = (
        temp["actual"].mean()
    )


    result = (

        temp
        .groupby("decile")

        .agg(

            n=(
                "actual",
                "size"
            ),

            adopters=(
                "actual",
                "sum"
            ),

            mean_probability=(
                "probability",
                "mean"
            ),

            adoption_rate=(
                "actual",
                "mean"
            )

        )

        .reset_index()

        .sort_values(
            "decile"
        )

    )


    result[
        "adoption_rate_pct"
    ] = (

        result[
            "adoption_rate"
        ]

        * 100

    )


    result[
        "lift"
    ] = (

        result[
            "adoption_rate"
        ]

        /
        overall_rate

    )


    result[
        "cumulative_adopters"
    ] = (
        result[
            "adopters"
        ].cumsum()
    )


    result[
        "cumulative_capture_rate"
    ] = (

        result[
            "cumulative_adopters"
        ]

        /
        temp[
            "actual"
        ].sum()

    )


    return result


