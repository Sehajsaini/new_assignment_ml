# 27. FEATURE ENGINEERING FUNCTION
# ================================================================

def engineer_features(
    behavioral_data,
    static_data
):

    data = behavioral_data.copy()

    data = data.sort_values(
        [
            "physician_id",
            "quarter_num"
        ]
    )


    rows = []


    variables = [

        "rep_calls",

        "samples_provided",

        "digital_engagements",

        "speaker_program_attendance",

        "congress_attendance",

        "competitive_rx_count",

        "peer_network_score",

        "medical_education_events"

    ]


    for physician_id, group in data.groupby(
        "physician_id"
    ):

        group = group.sort_values(
            "quarter_num"
        )


        row = {

            "physician_id":
                physician_id

        }


        # --------------------------------------------------------
        # TOTAL FEATURES
        # --------------------------------------------------------

        for col in variables:

            series = pd.to_numeric(
                group[col],
                errors="coerce"
            )

            row[
                f"{col}_total"
            ] = series.sum()

            row[
                f"{col}_mean"
            ] = series.mean()

            row[
                f"{col}_std"
            ] = series.std()

            row[
                f"{col}_last"
            ] = series.iloc[-1]


        # --------------------------------------------------------
        # EARLY WINDOW Q1-Q3
        # --------------------------------------------------------

        early = group[
            group["quarter_num"].isin(
                [1,2,3]
            )
        ]


        # --------------------------------------------------------
        # RECENT WINDOW Q8-Q10
        # --------------------------------------------------------

        recent = group[
            group["quarter_num"].isin(
                [8,9,10]
            )
        ]


        for col in variables:

            early_mean = (
                early[col]
                .mean()
            )

            recent_mean = (
                recent[col]
                .mean()
            )


            row[
                f"{col}_early_mean"
            ] = early_mean


            row[
                f"{col}_recent_mean"
            ] = recent_mean


            # ----------------------------------------------------
            # TREND
            # ----------------------------------------------------

            row[
                f"{col}_trend"
            ] = (
                recent_mean
                -
                early_mean
            )


        # --------------------------------------------------------
        # SPEAKER PROGRAM RECENCY
        # --------------------------------------------------------

        row[
            "speaker_recency_Q8_Q10"
        ] = (

            recent[
                "speaker_program_attendance"
            ]

            .sum()

        )


        # --------------------------------------------------------
        # CONGRESS RECENCY
        # --------------------------------------------------------

        row[
            "congress_recency_Q8_Q10"
        ] = (

            recent[
                "congress_attendance"
            ]

            .sum()

        )


        # --------------------------------------------------------
        # MONOTONIC MOMENTUM - LAST 4 QUARTERS
        # --------------------------------------------------------

        last4 = group[
            group["quarter_num"].isin(
                [7,8,9,10]
            )
        ].sort_values(
            "quarter_num"
        )


        for col in [

            "rep_calls",

            "samples_provided",

            "digital_engagements",

            "competitive_rx_count",

            "peer_network_score"

        ]:

            values = (
                last4[col]
                .dropna()
                .values
            )


            if len(values) >= 2:

                row[
                    f"{col}_monotonic_last4"
                ] = int(
                    np.all(
                        np.diff(values) >= 0
                    )
                    and
                    np.any(
                        np.diff(values) > 0
                    )
                )

            else:

                row[
                    f"{col}_monotonic_last4"
                ] = 0


        # --------------------------------------------------------
        # RECENT LINEAR SLOPE
        # --------------------------------------------------------

        for col in [

            "rep_calls",

            "samples_provided",

            "digital_engagements",

            "competitive_rx_count",

            "peer_network_score"

        ]:

            temp = recent[
                [
                    "quarter_num",
                    col
                ]
            ].dropna()


            if len(temp) >= 2:

                slope = np.polyfit(
                    temp[
                        "quarter_num"
                    ],
                    temp[col],
                    1
                )[0]

            else:

                slope = np.nan


            row[
                f"{col}_recent_slope"
            ] = slope


        rows.append(
            row
        )


    engineered = pd.DataFrame(
        rows
    )


    engineered = engineered.merge(
        static_data.drop_duplicates(
