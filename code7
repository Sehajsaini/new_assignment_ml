# 9. FEATURE ENGINEERING HELPER FUNCTIONS
# =============================================================================

def get_quarter_number(quarter):
    """Convert Q1, Q2, ..., Q10 into integers."""
    return int(quarter.replace("Q", ""))


def monotonic_increasing(values):
    """Check whether values are monotonically increasing."""
    values = list(values)

    return int(
        all(
            values[i] <= values[i + 1]
            for i in range(len(values) - 1)
        )
    )


def calculate_slope(values):
    """Calculate the linear trend slope."""
    values = np.asarray(values)

    if len(values) < 2:
        return 0

    x = np.arange(len(values))

    return np.polyfit(
        x,
        values,
        1
    )[0]


