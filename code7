# 10. MAIN FEATURE ENGINEERING FUNCTION
# =============================================================================

def create_physician_features(long_data, static_data):

    data = long_data.copy()

    data["quarter_num"] = data["quarter"].apply(
        get_quarter_number
    )

    data = data.sort_values(
        ["physician_id", "quarter_num"]
    )

    feature_df = pd.DataFrame(
        {
            "physician_id":
                data["physician_id"].unique()
        }
    )

    # =========================================================================
    # A. TOTAL AND AVERAGE BEHAVIOURAL FEATURES
    # =========================================================================

    activity_columns = [
        "rep_calls",
        "samples_provided",
        "digital_engagements",
        "competitive_rx_count",
        "medical_education_events"
    ]

    totals = (
        data.groupby("physician_id")[activity_columns]
        .sum()
        .add_prefix("total_")
        .reset_index()
    )

    means = (
        data.groupby("physician_id")[activity_columns]
        .mean()
        .add_prefix("mean_")
        .reset_index()
    )

    feature_df = feature_df.merge(
        totals,
        on="physician_id",
        how="left"
    )

    feature_df = feature_df.merge(
        means,
        on="physician_id",
        how="left"
    )

    # =========================================================================
    # B. RECENCY FEATURES – Q8 TO Q10
    # =========================================================================

    recent_data = data[
        data["quarter_num"].between(8, 10)
    ]

    recent_means = (
        recent_data.groupby("physician_id")[activity_columns]
        .mean()
        .add_prefix("recent_mean_")
        .reset_index()
    )

    feature_df = feature_df.merge(
        recent_means,
        on="physician_id",
        how="left"
    )

    # =========================================================================
    # C. EARLY PERIOD FEATURES – Q1 TO Q3
    # =========================================================================

    early_data = data[
        data["quarter_num"].between(1, 3)
    ]

    early_means = (
        early_data.groupby("physician_id")[activity_columns]
        .mean()
        .add_prefix("early_mean_")
        .reset_index()
    )

    feature_df = feature_df.merge(
        early_means,
        on="physician_id",
        how="left"
    )

    # =========================================================================
    # D. RECENCY VS EARLY MOMENTUM
    # =========================================================================

    for column in activity_columns:

        feature_df[f"{column}_trend"] = (
            feature_df[f"recent_mean_{column}"]
            - feature_df[f"early_mean_{column}"]
        )

        feature_df[f"{column}_recent_ratio"] = (
            feature_df[f"recent_mean_{column}"]
            / (
                feature_df[f"mean_{column}"] + 1
            )
        )

    # =========================================================================
    # E. Q10 – MOST RECENT QUARTER FEATURES
    # =========================================================================

    q10_data = data[
        data["quarter_num"] == 10
    ]

    q10_features = (
        q10_data[
            [
                "physician_id",
                "rep_calls",
                "samples_provided",
                "digital_engagements",
                "competitive_rx_count"
            ]
        ]
        .rename(
            columns={
                "rep_calls":
                    "q10_rep_calls",

                "samples_provided":
                    "q10_samples",

                "digital_engagements":
                    "q10_digital",

                "competitive_rx_count":
                    "q10_competitive_rx"
            }
        )
    )

    feature_df = feature_df.merge(
        q10_features,
        on="physician_id",
        how="left"
    )

    # =========================================================================
    # F. EVENT AND EDUCATIONAL ENGAGEMENT
    # =========================================================================

    event_features = (
        data.groupby("physician_id")
        .agg(
            total_speaker_programs=(
                "speaker_program_attendance",
                "sum"
            ),

            total_congress_attendance=(
                "congress_attendance",
                "sum"
            ),

            recent_speaker_programs=(
                "speaker_program_attendance",
                lambda x: x.iloc[-3:].sum()
            ),

            recent_congress_attendance=(
                "congress_attendance",
                lambda x: x.iloc[-3:].sum()
            )
        )
        .reset_index()
    )

    feature_df = feature_df.merge(
        event_features,
        on="physician_id",
        how="left"
    )

    # =========================================================================
    # G. PEER NETWORK FEATURES
    # =========================================================================

    peer_features = (
        data.groupby("physician_id")
        .agg(
            mean_peer_network_score=(
                "peer_network_score",
                "mean"
            ),

            recent_peer_network_score=(
                "peer_network_score",
                lambda x: x.iloc[-3:].mean()
            )
        )
        .reset_index()
    )

    peer_features["peer_network_trend"] = (
        peer_features["recent_peer_network_score"]
        - peer_features["mean_peer_network_score"]
    )

    feature_df = feature_df.merge(
        peer_features,
        on="physician_id",
        how="left"
    )

    # =========================================================================
    # H. MOMENTUM AND SLOPE FEATURES
    # =========================================================================

    momentum_features = []

    for physician_id, group in data.groupby("physician_id"):

        group = group.sort_values("quarter_num")

        last_four = group.tail(4)

        momentum_features.append(
            {
                "physician_id": physician_id,

                "rep_calls_increasing_4q":
                    monotonic_increasing(
                        last_four["rep_calls"].values
                    ),

                "digital_increasing_4q":
                    monotonic_increasing(
                        last_four["digital_engagements"].values
                    ),

                "samples_increasing_4q":
                    monotonic_increasing(
                        last_four["samples_provided"].values
                    ),

                "rep_calls_slope":
                    calculate_slope(
                        group["rep_calls"].values
                    ),

                "digital_slope":
                    calculate_slope(
                        group["digital_engagements"].values
                    ),

                "samples_slope":
                    calculate_slope(
                        group["samples_provided"].values
                    ),

                "competitive_rx_slope":
                    calculate_slope(
                        group[
                            "competitive_rx_count"
                        ].values
                    )
            }
        )

    momentum_features = pd.DataFrame(
        momentum_features
    )

    feature_df = feature_df.merge(
        momentum_features,
        on="physician_id",
        how="left"
    )

    # =========================================================================
    # I. BUSINESS-FOCUSED CHANNEL INTERACTION FEATURES
    # =========================================================================

    feature_df["digital_to_calls_ratio"] = (
        feature_df["total_digital_engagements"]
        / (
            feature_df["total_rep_calls"] + 1
        )
    )

    feature_df["samples_per_call"] = (
        feature_df["total_samples_provided"]
        / (
            feature_df["total_rep_calls"] + 1
        )
    )

    feature_df["recent_push_score"] = (
        feature_df["rep_calls_trend"]
        + feature_df["samples_provided_trend"]
        + feature_df["digital_engagements_trend"]
    )

    feature_df["recent_engagement_score"] = (
        feature_df["recent_mean_rep_calls"]
        + feature_df[
            "recent_mean_digital_engagements"
        ]
        + feature_df[
            "recent_mean_samples_provided"
        ]
    )

    # =========================================================================
    # J. MERGE STATIC PHYSICIAN FEATURES
    # =========================================================================

    feature_df = feature_df.merge(
        static_data,
        on="physician_id",
        how="left"
    )

    return feature_df


